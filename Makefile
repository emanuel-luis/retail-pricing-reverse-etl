SHELL := bash
.SHELLFLAGS := -eu -o pipefail -c
.DEFAULT_GOAL := help
# Git Bash on Windows would rewrite container paths such as /var/lib/... into Windows paths.
export MSYS_NO_PATHCONV := 1

.PHONY: help install lint fmt test test-fast test-data test-sql data env up down ps logs load control-init ch-init ch-load s3-init dbt-build test-clickhouse workload workload-stop runner-logs flows deploy cycle test-integration demo heavy report check d2-install diagrams diagrams-check diagrams-watch

# Scale factor of the TPC-DS data: 0.01 (CI), 1 (default demo), 10 (documented heavy run).
SF ?= 1

help: ## Show this help
	@grep -hE '^[a-zA-Z0-9_-]+:.*## ' $(MAKEFILE_LIST) | awk -F ':.*## ' '{printf "  %-17s %s\n", $$1, $$2}'

install: ## Install dependencies
	uv sync --locked

lint: ## Ruff check, ruff format check, mypy (the CI lint job)
	uv run ruff check
	uv run ruff format --check
	uv run mypy

fmt: ## Format and apply safe lint fixes
	uv run ruff format
	uv run ruff check --fix

test-fast: ## Unit tests, no data and no stack
	uv run pytest

test-data: ## Generate and build TPC-DS SF0.01 in a temp dir and check it (marker slow)
	uv run pytest -m slow

test: test-fast test-data ## Everything that runs without the stack

data: ## Generate TPC-DS and build the OLTP seed at scale SF (make data SF=0.01)
	uv run retail-pricing data all --sf $(SF)

test-sql: ## SQL tests against the compose Postgres services (make up load control-init first)
	uv run pytest -m sql

# Stack. Every service has a profile; .env sets COMPOSE_PROFILES=core for a bare `up`.
ALL_PROFILES := --profile core --profile workload

env: ## Copy .env.example to .env when .env is missing (local-only passwords)
	@[ -f .env ] || { cp .env.example .env; echo "created .env from .env.example (local-only values)"; }

up: env ## Start the core services and wait until they are healthy
	docker compose up -d --build --wait

down: ## Stop every service of this project and delete its volumes
	docker compose $(ALL_PROFILES) down -v --remove-orphans

ps: ## Show service status
	docker compose $(ALL_PROFILES) ps

logs: ## Follow the logs of every service
	docker compose $(ALL_PROFILES) logs -f --tail 100

load: ## Load the OLTP seed of scale SF into Postgres (make data first)
	uv run retail-pricing oltp load --sf $(SF)

control-init: ## Create the control/audit schemas, functions, roles and registry seed
	uv run retail-pricing control init

ch-init: ## Create the ClickHouse databases and raw tables (make up first)
	uv run retail-pricing ch init

ch-load: ## Load the seed Parquet into ClickHouse raw: make ch-load SF=0.01 CYCLE=1
	uv run retail-pricing ch load-raw --sf $(SF) --cycle $(CYCLE)

s3-init: ## Create the raw bucket in the S3-compatible store (idempotent)
	uv run retail-pricing s3 init

# dbt runs inside the dbt-runner container, the same way NiFi calls it.
CYCLE ?= 1
AS_OF ?= 2025-12-04
dbt-build: ## Run dbt build for a cycle through the dbt runner: make dbt-build CYCLE=1 AS_OF=2025-12-04
	uv run retail-pricing dbt-runner trigger --cycle $(CYCLE) --as-of $(AS_OF)

test-clickhouse: ## ClickHouse tests (raw DDL, loads, users, bucket) against the running service
	uv run pytest -m clickhouse

# --profile on the command line replaces COMPOSE_PROFILES, so the core profile is named again.
workload: env ## Start the OLTP workload generator (profile workload)
	docker compose $(ALL_PROFILES) build dbt-runner
	docker compose $(ALL_PROFILES) up -d --wait workload

workload-stop: ## Stop the workload generator
	docker compose $(ALL_PROFILES) stop workload

runner-logs: ## Follow the dbt runner logs
	docker compose $(ALL_PROFILES) logs -f --tail 100 dbt-runner

# NiFi: the flow is generated by the builder; deploy replaces the retail-pricing group.
MODE ?= incremental
flows: ## Generate nifi/flows/retail-pricing.json from the flow builder (CI diffs it)
	uv run retail-pricing nifi build-flows

deploy: ## Deploy the flow to the running NiFi with the local parameters
	uv run retail-pricing nifi deploy --env local --flow nifi/flows/retail-pricing.json

cycle: ## Trigger a cycle and wait for it: make cycle MODE=full (default incremental)
	uv run retail-pricing cycle trigger --mode $(MODE) --wait

test-integration: ## Cycles through the deployed flow (stack up, loaded, initialized, deployed)
	uv run pytest -m integration

# Full runs write runs/<utc>-sf<SF>/ (steps.json, check.txt, timings.json and timings.md).
demo: ## Whole loop at scale SF: stack, load, deploy, 3 cycles with forced conflicts, check, report
	SF=$(SF) bash scripts/demo.sh

heavy: ## Documented heavy run, workload on throughout, docker stats sampled (make heavy SF=10)
	SF=$(if $(filter command line,$(origin SF)),$(SF),10) bash scripts/heavy.sh

RUN_DIR ?= $(lastword $(sort $(wildcard runs/*-sf*)))
report: ## Write timings.json and timings.md for a run: make report RUN_DIR=runs/<utc>-sf1 (default: latest)
	@[ -n "$(RUN_DIR)" ] || { echo "no run under runs/: run make demo first, or pass RUN_DIR=" >&2; exit 1; }
	uv run retail-pricing report --run-dir $(RUN_DIR)

CYCLES ?= 1-3
check: ## Assert the loop's invariants on finished cycles: make check CYCLES=1-3
	uv run retail-pricing check --cycles $(CYCLES)

# Diagrams: docs/diagrams/<name>.d2 rendered to <name>.svg (committed). One pinned D2 everywhere.
# Layout engine, themes and padding live in docs/diagrams/_style.d2 (d2-config), so d2 runs in a
# clean environment: D2_* and SCALE variables would override that config. --scale 1 is not a
# d2-config key; it writes the natural width and height, so GitHub never upscales a small diagram.
D2_VERSION := 0.9.0
# sha256 of d2-v$(D2_VERSION)-linux-amd64.tar.gz, from the release's SHA256SUMS
D2_SHA256 := 5669ddc46b99e942cc96078f4a4e36d5e62103348f4c05179ede27802fdd87a9
D2_HOME ?= $(HOME)/.local/share/d2/v$(D2_VERSION)
D2 ?= $(D2_HOME)/bin/d2
D2_RUN = env -i PATH="$$PATH" HOME="$$HOME" "$(D2)" --scale 1
DIAGRAMS := $(filter-out docs/diagrams/_%,$(wildcard docs/diagrams/*.d2))

d2-install: ## Install the pinned D2 (Linux x86_64) into D2_HOME, checksum verified
	@if [ -x "$(D2_HOME)/bin/d2" ]; then echo "D2 v$(D2_VERSION) already in $(D2_HOME)"; exit 0; fi; \
	[ "$$(uname -sm)" = "Linux x86_64" ] || { echo "d2-install covers Linux x86_64 only;" \
		"install D2 v$(D2_VERSION) yourself and pass D2=/path/to/d2" >&2; exit 1; }; \
	tmp="$$(mktemp -d)"; trap 'rm -rf "$$tmp"' EXIT; \
	curl -fsSLo "$$tmp/d2.tar.gz" \
		"https://github.com/terrastruct/d2/releases/download/v$(D2_VERSION)/d2-v$(D2_VERSION)-linux-amd64.tar.gz"; \
	echo "$(D2_SHA256)  $$tmp/d2.tar.gz" | sha256sum --check --strict; \
	tar -xzf "$$tmp/d2.tar.gz" -C "$$tmp"; \
	mkdir -p "$(D2_HOME)/bin"; \
	install -m 0755 "$$tmp/d2-v$(D2_VERSION)/bin/d2" "$(D2_HOME)/bin/d2"; \
	"$(D2_HOME)/bin/d2" --version

diagrams: ## Render docs/diagrams/*.d2 to SVG with the pinned D2 (make d2-install once)
	@v="$$($(D2_RUN) --version 2>/dev/null || true)"; [ "$$v" = "v$(D2_VERSION)" ] || { \
		echo "need D2 v$(D2_VERSION) at $(D2), found '$${v:-nothing}': run make d2-install" >&2; exit 1; }
	@for f in $(DIAGRAMS); do $(D2_RUN) "$$f" "$${f%.d2}.svg"; done

diagrams-check: diagrams ## Render, then fail if a committed SVG is stale, missing or has no source
	@shopt -s nullglob; for s in docs/diagrams/*.svg; do \
		[ -f "$${s%.svg}.d2" ] || { echo "$$s has no .d2 source" >&2; exit 1; }; done
	@changed="$$(git status --porcelain --untracked-files=all -- 'docs/diagrams/*.svg')"; \
	if [ -n "$$changed" ]; then echo "$$changed" >&2; \
		echo "rendered SVGs differ from the committed ones: run make diagrams and commit" >&2; exit 1; fi

diagrams-watch: ## Live preview in the browser while editing: make diagrams-watch NAME=architecture
	@# NAME only from the command line: WSL exports NAME (the hostname) into every shell.
	@[ "$(origin NAME)" = "command line" ] && [ -f "docs/diagrams/$(NAME).d2" ] || { \
		echo "usage: make diagrams-watch NAME=<one of: $(basename $(notdir $(DIAGRAMS)))>" >&2; exit 1; }
	$(D2_RUN) --watch --browser "$${BROWSER:-0}" docs/diagrams/$(NAME).d2 docs/diagrams/$(NAME).svg
