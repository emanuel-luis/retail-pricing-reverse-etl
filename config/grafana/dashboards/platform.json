        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (datname) (rate(pg_stat_database_tup_deleted{datname=~\"retail|control\"}[1m]))",
          "legendFormat": "{{datname}} deleted",
          "range": true
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 52
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "id": 15
    },
    {
      "title": "Postgres cache hit ratio",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (datname) (rate(pg_stat_database_blks_hit{datname=~\"retail|control\"}[5m])) / (sum by (datname) (rate(pg_stat_database_blks_hit{datname=~\"retail|control\"}[5m])) + sum by (datname) (rate(pg_stat_database_blks_read{datname=~\"retail|control\"}[5m])))",
          "legendFormat": "{{datname}}",
          "range": true
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 60
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {},
      "id": 16
    },
    {
      "title": "Postgres dead tuples (top 10 tables)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(10, pg_stat_user_tables_n_dead_tup)",
          "legendFormat": "{{datname}} {{schemaname}}.{{relname}}",
          "range": true
