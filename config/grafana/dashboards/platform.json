{
  "uid": "platform",
  "title": "Platform",
  "description": "NiFi, ClickHouse, both Postgres databases, the workload generator and the dbt runner, from Prometheus.",
  "tags": [
    "retail-pricing"
  ],
  "editable": false,
  "schemaVersion": 41,
  "version": 1,
