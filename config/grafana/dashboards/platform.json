      "options": {},
      "id": 11
    },
    {
      "title": "Postgres connections",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (datname) (pg_stat_database_numbackends{datname=~\"retail|control\"})",
          "legendFormat": "{{datname}}",
          "range": true
