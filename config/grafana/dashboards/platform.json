        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (datname) (rate(pg_stat_database_tup_updated{datname=~\"retail|control\"}[1m]))",
          "legendFormat": "{{datname}} updated",
          "range": true
