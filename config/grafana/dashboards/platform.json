          "expr": "sum by (datname) (rate(pg_stat_database_xact_commit{datname=~\"retail|control\"}[1m]) + rate(pg_stat_database_xact_rollback{datname=~\"retail|control\"}[1m]))",
          "legendFormat": "{{datname}}",
          "range": true
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 36
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
