# The NiFi flow generated by retail-pricing nifi build-flows: the trigger, the two stage groups
# (each a barrier: Single FlowFile Per Node + Batch Output), the gates in the parent group and
# finalize, with the systems each step reads or writes. Grounded in
# src/retail_pricing/nifi/builder/ (trigger, extract, load, gate, finalize) and
# nifi/flows/retail-pricing.json. Dashed edges: audit writes and control calls to the control DB.
...@_style

title: "NiFi flow: one cycle from trigger to finalize" {
  shape: text
  near: top-center
  style: {font-size: 24; bold: true}
}

direction: down

operator: "operator or CI\nretail-pricing cycle trigger\nPOST :8081/cycles" {class: actor}
schedule: "every minute\nstart_cycle_if_due\n(registry interval)" {class: source}

trigger: "00 trigger\nvalidate the body, start_cycle:\n202 started, 409 busy, 400 bad" {class: process}

oltp: "oltp Postgres\nretail" {class: store}
extract: "10 extract · barrier\nstart_run, extract_plan (watermark\nwindow, 2 min overlap), one item\nper table: full = GenerateTableFetch\npages, incremental = window query;\nExecuteSQLRecord to Parquet" {class: process}
s3: "s3 (RustFS) retail-raw\nraw/<table>/cycle=<c>/run=<r>/\npart-*.parquet" {class: store}

gate_extract: "gate: end_run\na failed or open step\nfails the stage" {class: check}

load: "20 load · barrier\nload_plan, one item per table:\nInvokeHTTP INSERT INTO raw.t\nSELECT ... FROM s3(raw_s3, filename)\nwritten_rows must equal extracted" {class: process}
clickhouse: "clickhouse\nraw.* ReplacingMergeTree(version)" {class: store}

gate_load: "gate: end_run,\nthen commit_watermarks\n(only after a good load)" {class: check}

finalize: "90 finalize\nfinish_cycle: succeeded,\nor failed with its stage" {class: process}

control: "control-db Postgres\nregistry: jobs, extract list, watermarks\naudit: cycle, job_run, step_event, alert" {class: store}

operator -> trigger
schedule -> trigger
trigger -> extract
oltp -> extract
extract -> s3
extract -> gate_extract
gate_extract -> load
s3 -> clickhouse
load -> clickhouse {class: meta}
load -> gate_load
gate_load -> finalize
gate_extract -> finalize {class: meta}

trigger -> control {class: meta}
extract -> control {class: meta}
load -> control {class: meta}
gate_extract -> control {class: meta}
gate_load -> control {class: meta}
finalize -> control {class: meta}

legend: Legend {
  class: legend
  grid-columns: 3
  actor: "caller" {class: [actor; legend-actor]}
  source: "timer" {class: [source; legend-item]}
  process: "process group" {class: [process; legend-item]}
  store: "database or bucket" {class: [store; legend-store]}
  check: "stage gate" {class: [check; legend-item]}
  edges: "solid: data or flow\ndashed: control and audit" {shape: text; style.font-size: 13}
}
