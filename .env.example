# Local development values only. `make env` (and `make up`) copy this file to .env when it is missing.
# Every service binds to 127.0.0.1; change every password before exposing anything.
COMPOSE_PROFILES=core

# OLTP Postgres (database retail). The owner creates the schema; the other roles are created by
# `retail-pricing oltp load` with these passwords.
OLTP_PG_PORT=25432
OLTP_DB=retail
OLTP_OWNER_USER=oltp_owner
OLTP_OWNER_PASSWORD=oltp-owner-local-pw
OLTP_WORKLOAD_PASSWORD=oltp-workload-local-pw
OLTP_NIFI_PASSWORD=oltp-nifi-local-pw
OLTP_EXPORTER_PASSWORD=oltp-exporter-local-pw

# Control/audit Postgres (database control).
CONTROL_PG_PORT=25433
CONTROL_DB=control
CONTROL_OWNER_USER=control_owner
CONTROL_OWNER_PASSWORD=control-owner-local-pw
CONTROL_NIFI_PASSWORD=control-nifi-local-pw
CONTROL_GRAFANA_PASSWORD=control-grafana-local-pw
CONTROL_EXPORTER_PASSWORD=control-exporter-local-pw

# Workload generator (profile workload).
WORKLOAD_SEED=7
WORKLOAD_SALES_PER_SECOND=20
WORKLOAD_PRICE_EDITS_PER_SECOND=0.5
WORKLOAD_DAY_SECONDS=600
